APP_NAME=LUGHA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local SQLite works out of the box. For PostgreSQL (production engine): `docker compose up -d` in lugha/, then:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=54329
# DB_DATABASE=lugha
# DB_USERNAME=lugha
# DB_PASSWORD=lugha-local-only
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Payments — Moyasar. Never commit real keys; use Moyasar test keys (sk_test_…) on staging.
# PAYMENT_GATEWAY=fake only on a developer machine.
PAYMENT_GATEWAY=moyasar
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
MOYASAR_WEBHOOK_SECRET=
LUGHA_VAT_RATE_BPS=1500
LUGHA_SELLER_NAME=LUGHA
LUGHA_SELLER_VAT_NUMBER=
ADMIN_MFA_REQUIRED=true
HYPERPAY_BASE_URL=https://eu-test.oppwa.com
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_TEST_MODE=true
HYPERPAY_WEBHOOK_KEY=
HYPERPAY_ENTITY_MADA=
HYPERPAY_ENTITY_CARD=
HYPERPAY_ENTITY_APPLEPAY=
LUGHA_SELLER_CR_NUMBER=
LUGHA_SELLER_ADDRESS=
